NODE_ENV=production
APP_ORIGIN=https://pillars.example.undp.org
PORT=8080
TRUST_PROXY=true

# Configure a single-tenant Microsoft Entra web application.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=configure-in-secret-manager
ENTRA_REDIRECT_URI=https://pillars.example.undp.org/auth/callback

# Use a private TLS-enabled Redis instance for server-side sessions.
REDIS_URL=rediss://redis.example.internal:6380
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: server-side myACLED API account for direct conflict-data queries.
# Store real values in a secret manager; never put them in browser/client config.
ACLED_USERNAME=
ACLED_PASSWORD=

# Optional static Netlify snapshot window; defaults to the trailing 365 days ending today.
# These are build settings; ACLED credentials must never be included in the static output.
# ACLED_SNAPSHOT_START=2025-10-21
# ACLED_SNAPSHOT_END=2026-10-20