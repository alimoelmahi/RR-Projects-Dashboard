{
  "name": "recovery-resilience-monitor",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "node scripts/audit.mjs",
    "data": "node scripts/build-data.mjs",
    "dev": "vite --host 127.0.0.1",
    "start": "node server.mjs",
    "dev:sso": "npm run build && npm start",
    "build": "vite build",
    "snapshot:acled": "node scripts/fetch-acled-snapshot.mjs",
    "build:static": "npm run snapshot:acled && vite build --mode static",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@azure/msal-node": "^7.1.0",
    "@undp/design-system-assets": "^2.0.4",
    "connect-redis": "^10.0.0",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide": "^0.468.0",
    "polygon-clipping": "^0.15.7",
    "redis": "^6.3.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "supertest": "^7.3.1",
    "vite": "^6.4.1"
  }
}
